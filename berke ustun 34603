# event.py
from collections import deque

class Event:
    def __init__(self, payload):
        self.payload = payload

class ApplicationSentEvent(Event):
    pass

class ApplicationAcceptedEvent(Event):
    pass

class ApplicationRejectedEvent(Event):
    pass

# queue.py
class CommunicationQueue:
    def __init__(self):
        self.queue = deque()
    
    def send_event(self, event):
        self.queue.append(event)
    
    def process_events(self):
        while self.queue:
            event = self.queue.popleft()
            print(f"Processing event: {event.__class__.__name__} - {event.payload}")

# university.py
class University:
    def __init__(self, name):
        self.name = name
    
    def receive_application(self, student, queue):
        print(f"{student.name} applied to {self.name}")
        queue.send_event(ApplicationSentEvent(f"{student.name} applied to {self.name}"))
        
        if student.grade > 75:
            queue.send_event(ApplicationAcceptedEvent(f"{student.name} was accepted to {self.name}"))
        else:
            queue.send_event(ApplicationRejectedEvent(f"{student.name} was rejected by {self.name}"))

# student.py
class Student:
    def __init__(self, name, grade):
        self.name = name
        self.grade = grade
    
    def apply_to_university(self, university, queue):
        university.receive_application(self, queue)

# main.py
from event import ApplicationSentEvent, ApplicationAcceptedEvent, ApplicationRejectedEvent
from queue import CommunicationQueue
from university import University
from student import Student

if __name__ == "__main__":
    queue = CommunicationQueue()
    student1 = Student("Alice", 80)
    student2 = Student("Bob", 70)
    university = University("Tech University")
    
    student1.apply_to_university(university, queue)
    student2.apply_to_university(university, queue)
    
    queue.process_events()
